{
  "mcpServers": {
    "sophon": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "https://gitee.com/wangeek/IO_agent/releases/download/sophon-bridge-v0.2.3/sophon-bridge-0.2.3.tgz"],
      "runtime": {
        "type": "node",
        "version": ">=18.0.0"
      },
      "env": {
        "SOPHON_NAME": "${SOPHON_NAME}",
        "SOPHON_PSK": "${SOPHON_PSK}"
      },
      "timeout": 30000
    }
  }
}

{
  "mcpServers": {
    "sophon": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "https://dash.18181010.xyz/store/sophon-bridge-0.2.2.tgz"],
      "runtime": {
        "type": "node",
        "version": ">=18.0.0"
      },
      "env": {
        "SOPHON_NAME": "${SOPHON_NAME}",
        "SOPHON_PSK": "${SOPHON_PSK}"
      },
      "timeout": 30000
    }
  }
}
